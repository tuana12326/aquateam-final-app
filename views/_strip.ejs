<%if(sponsors.length){%><div class="strip"><%for(const s of sponsors){%><a href="<%=s.link||'#'%>" target="_blank" rel="noopener" title="<%=s.name%>"><%if(s.logo){%><img src="<%=s.logo%>" alt="<%=s.name%>"><%}else{%><%=s.name%><%}%></a><%}%></div><%}else{%><p class="muted"><%=x('Destekçilerimiz yakında burada yer alacak. Siz de olabilirsiniz:','Our supporters will be listed here soon. You could be one:')%> <a href="/sponsor#teklif"><%=x('teklif talep edin','request a quote')%></a>.</p><%}%>
