<%/* kind, fields, pre (ön seçili değerler) */
const L={name:['Ad Soyad','Full name'],email:['E-posta','Email'],company:['Kurum / Firma','Company / Organization'],phone:['Telefon (isteğe bağlı)','Phone (optional)'],package:['İlgilendiğiniz paket','Package of interest'],dept:['Hedef departman','Target department'],grade:['Bölüm ve sınıf','Department & year'],message:['Mesajınız','Your message']};
const E={name:['Lütfen adınızı giriniz.','Please enter your name.'],email:['Geçerli bir e-posta adresi giriniz.','Please enter a valid email address.'],company:['Kurum veya firma adını giriniz.','Please enter the company name.'],phone:['Geçerli bir telefon numarası giriniz.','Please enter a valid phone number.'],package:['Geçerli bir paket seçiniz.','Please choose a valid package.'],dept:['Bir departman seçiniz.','Please choose a department.'],grade:['Bölüm ve sınıfınızı giriniz.','Please enter your department and year.'],message:['En az 5 karakterlik bir mesaj yazınız.','Please write a message of at least 5 characters.']};
const PK={platin:['Platin Sponsorluk','Platinum Sponsorship'],altin:['Altın Sponsorluk','Gold Sponsorship'],gumus:['Gümüş Sponsorluk','Silver Sponsorship'],ayni:['Ayni / Teknik Destek','In-kind / Technical Support'],dosya:['Sponsorluk Dosyası Talebi','Sponsorship File Request']};
const DP=[['Yazılım Ekibi','Software Team'],['Donanım Ekibi','Hardware Team'],['Mekanik Ekibi','Mechanical Team'],['Test Ekibi','Test Team'],['Pilot Ekibi','Pilot Team']];
const PRE=typeof pre==='undefined'?{}:pre;const val=n=>(flash&&flash.values&&flash.values[n])||PRE[n]||'';const bad=n=>!!(flash&&flash.errors&&flash.errors.includes(n));
const ph={message:{contact:['Size nasıl yardımcı olabiliriz?','How can we help?'],sponsor:['Destek planınızı veya sormak istediklerinizi yazın (isteğe bağlı).','Tell us about your support plans or questions (optional).'],apply:['Kullandığınız araçlar, LinkedIn/GitHub profiliniz ve kısa tanıtımınız.','Tools you use, your LinkedIn/GitHub profile and a short intro.']}};%>
<form method="post" action="/form/<%=kind%>" id="<%=kind=='sponsor'?'teklif':kind=='apply'?'apply-form':'f'%>" class="f" novalidate data-kind="<%=kind%>">
<%if(q.ok){%><p class="note ok" role="status">✓ <%=x('Talebiniz alındı ve takım e-postasına iletildi. En kısa sürede size dönüş yapacağız.','Your request has been received and forwarded to the team. We will get back to you shortly.')%></p><%}%>
<%if(flash&&flash.errors&&flash.errors[0]=='rate'){%><p class="note err" role="alert"><%=x('Çok fazla deneme yaptınız, lütfen birkaç dakika sonra tekrar deneyin.','Too many attempts, please try again in a few minutes.')%></p><%}else if(q.err){%><p class="note err" role="alert"><%=x('Lütfen işaretli alanları kontrol edin.','Please check the highlighted fields.')%></p><%}%>
<input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
<%for(const n of fields){const req=n=='message'?kind!='sponsor':n!='phone'&&n!='package';
if(n=='message'){%><label class="<%=bad(n)?'bad':''%>"><%=x(...L[n])%><textarea name="message" <%=req?'required':''%> minlength="<%=req?5:0%>" maxlength="2000" placeholder="<%=x(...ph.message[kind])%>"><%=val(n)%></textarea><span class="fe"><%=x(...E[n])%></span></label>
<%}else if(n=='package'||n=='dept'){const opts=n=='package'?Object.entries(PK):DP.map(d=>[d[0],d]);const cur=val(n);%><label class="<%=bad(n)?'bad':''%>"><%=x(...L[n])%><select name="<%=n%>" <%=n=='dept'?'required':''%>><option value=""><%=x('Seçiniz','Select')%></option><%for(const [k,v] of opts){%><option value="<%=k%>" <%=cur==k?'selected':''%>><%=x(...v)%></option><%}%></select><span class="fe"><%=x(...E[n])%></span></label>
<%}else{%><label class="<%=bad(n)?'bad':''%>"><%=x(...L[n])%><input name="<%=n%>" type="<%=n=='email'?'email':n=='phone'?'tel':'text'%>" value="<%=val(n)%>" <%=req?'required':''%> maxlength="200" autocomplete="<%=n=='email'?'email':n=='name'?'name':n=='company'?'organization':n=='phone'?'tel':'off'%>"><span class="fe"><%=x(...E[n])%></span></label><%}}%>
<button type="submit"><%=kind=='sponsor'?x('Teklif Talebini Gönder','Send Quote Request'):kind=='apply'?x('Başvuruyu Gönder','Submit Application'):x('Mesajı Gönder','Send Message')%></button></form>
