<%-include('head')%>
<%const D={kaptan:['Takım Kaptanı','Team Captain','5 mühendislik departmanının koordinasyonu, TEKNOFEST TYF/KTR teknik raporlama, risk yönetimi ve kurumsal sponsorluk süreçleri.','Coordination of 5 engineering departments, TEKNOFEST TYF/KTR technical reporting, risk management and corporate sponsorship processes.'],mekanik:['Mekanik','Mechanical','Hidrodinamik gövde geometrileri, SOLIDWORKS akışkanlar analizi, çift katmanlı O-ring sızdırmazlık ve 3B/lazer imalat süreçleri.','Hydrodynamic hull geometry, SOLIDWORKS fluid analysis, double O-ring sealing and 3D/laser manufacturing.'],yazilim:['Yazılım','Software','Jetson Orin Nano üzerinde YOLOv9/OpenCV nesne tespiti, CLAHE, Pymavlink otonomisi, Gazebo simülasyonu ve PyQt5 CORAL Arayüz v2.3.','YOLOv9/OpenCV detection on Jetson Orin Nano, CLAHE, Pymavlink autonomy, Gazebo simulation and the PyQt5 CORAL Interface v2.3.'],elektronik:['Donanım','Hardware','İzole güç mimarisi, Pixhawk 2.4.8 entegrasyonu, Proteus özgün PCB tasarımı, 40A/30A ESC ve Ethernet veri altyapısı.','Isolated power architecture, Pixhawk 2.4.8 integration, custom Proteus PCBs, 40A/30A ESCs and Ethernet data infrastructure.'],test:['Test','Test','7 aşamalı doğrulama matrisi: FMEA, tüp basınç ve sızdırmazlık testleri, sensör kalibrasyonu ve Mini ROV ayrılma/kenetlenme testleri.','7-stage validation matrix: FMEA, tube pressure and sealing tests, sensor calibration and Mini ROV detach/dock tests.'],pilot:['Pilot','Pilot','Ana ve Mini ROV manuel kontrol operasyonları, dar alan manevra simülasyonları ve yüzey istasyonu ile gerçek zamanlı saha iletişimi.','Manual control of the Main and Mini ROV, tight-space maneuver simulations and real-time field communication with the surface station.']};
const gr=s=>lang=='tr'?s:s.replace('Elektrik-Elektronik Müh.','Electrical-Electronics Eng.').replace('Bilgisayar Müh.','Computer Eng.').replace('Makine Müh.','Mechanical Eng.').replace('Otonom','Autonomous Systems').replace('Öğr. Gör.','Lecturer').replace(/(\d)\. Sınıf/,'Year $1');
const adv=m.filter(r=>r.dept=='danisman'),act=m.filter(r=>!r.alumni&&r.dept!='danisman'),alu=m.filter(r=>r.alumni&&r.dept!='danisman');
const cnt=k=>act.filter(r=>r.dept.split(',').includes(k)).length;%>
<div class="ph"><div class="wrap"><p class="eyebrow"><%=x('Kritik Tasarım Raporu — Bölüm 2','Critical Design Report — Section 2')%></p><h1>AquaTeam <span class="acc"><%=x('organizasyon ve kadro','organization & team')%></span></h1><p><%=x('Afyon Kocatepe Üniversitesi bünyesinde akademik danışman ve mühendislik öğrencilerinden oluşan ekibimiz; Yazılım, Donanım, Mekanik, Test ve Pilot departmanlarında yapılanmıştır.','Our team at Afyon Kocatepe University, made up of an academic advisor and engineering students, is organized into Software, Hardware, Mechanical, Test and Pilot departments.')%></p></div></div>
<section class="sec"><div class="wrap">
<%if(adv.length){%><p class="eyebrow"><%=x('Akademik Danışman','Academic Advisor')%></p><div class="grid" style="margin-bottom:44px"><%for(const r of adv){%><%-include('_member',{r,D,gr})%><%}%></div><%}%>
<p class="eyebrow"><%=x('Departmanlar','Departments')%></p><div class="grid g3" style="margin-bottom:56px"><%for(const k in D){%><div class="card"><h3><%=D[k][lang=='tr'?0:1]%> <span class="tag"><%=cnt(k)%></span></h3><p><%=D[k][lang=='tr'?2:3]%></p></div><%}%></div>
<div class="chips" id="tabs"><button class="on" data-t="act"><%=x('Aktif Kadro','Active Team')%> (<%=act.length%>)</button><button data-t="alu"><%=x('Mezunlar (Alumni)','Alumni')%> (<%=alu.length%>)</button></div>
<div id="p-act"><div class="chips" id="dchips"><button class="on" data-d=""><%=x('Tümü','All')%></button><%for(const k in D){%><button data-d="<%=k%>"><%=D[k][lang=='tr'?0:1]%></button><%}%></div>
<div class="grid" id="mem"><%for(const r of act){%><%-include('_member',{r,D,gr})%><%}%></div><%if(!act.length){%><p class="muted"><%=x('Ekip bilgileri yakında güncellenecek.','Team details coming soon.')%></p><%}%></div>
<div id="p-alu" hidden><%if(alu.length){%><div class="grid"><%for(const r of alu){%><%-include('_member',{r,D,gr})%><%}%></div><%}else{%><div class="soon"><%=x('İleriki dönemlerde mezunlarımız burada yer alacak.','Our alumni will be listed here in future seasons.')%></div><%}%></div></div></section>
<section class="sec alt" id="apply"><div class="wrap"><div class="sec-h"><p class="eyebrow"><%=x('Yeni Dönem Alımları','New-Season Recruitment')%></p><div class="rule"></div><h2><%=x('Aramıza','Join')%> <b><%=x('katılın','us')%></b></h2><p><%=x('Afyon Kocatepe Üniversitesi öğrencisiyseniz ve insansız su altı sistemleri, gömülü elektronik, yapay zekâ tabanlı görüntü işleme veya mekanik tasarım alanlarında aktif sorumluluk almak istiyorsanız başvurunuzu bekliyoruz.','If you are an Afyon Kocatepe University student and want to take an active role in unmanned underwater systems, embedded electronics, AI-based image processing or mechanical design, we look forward to your application.')%></p></div>
<div class="grid g3 steps" style="margin-bottom:40px"><%for(const [a,b,c,d] of [['Formu doldurun','Fill in the form','Bölümünüzü, sınıfınızı ve ilgilendiğiniz departmanı belirtin.','State your department, year and the team you are interested in.'],['Değerlendirme','Review','Başvurunuz ilgili departman sorumlusu ve takım kaptanı tarafından incelenir.','Your application is reviewed by the department lead and the team captain.'],['Tanışma','Meet the team','E-posta ile dönüş yapılır ve atölye tanışma görüşmesi planlanır.','We reply by email and plan an introduction meeting at the workshop.']]){%><div class="card"><h3><%=x(a,b)%></h3><p><%=x(c,d)%></p></div><%}%></div>
<p class="muted" style="max-width:760px"><b><%=x('Teknik yetkinlik alanları:','Technical areas:')%></b> Python/C++, YOLOv9 &amp; OpenCV, PyQt5, Pymavlink/ArduSub, SOLIDWORKS/CATIA, Proteus PCB, <%=x('güç elektroniği ve saha test mühendisliği.','power electronics and field test engineering.')%></p>
<%-include('_form',{kind:'apply',fields:['name','email','dept','grade','message']})%></div></section>
<script>
document.querySelectorAll('#tabs button').forEach(function(b){b.onclick=function(){document.querySelectorAll('#tabs button').forEach(function(c){c.classList.toggle('on',c===b)});document.getElementById('p-act').hidden=b.dataset.t!=='act';document.getElementById('p-alu').hidden=b.dataset.t!=='alu'}});
document.querySelectorAll('#dchips button').forEach(function(b){b.onclick=function(){document.querySelectorAll('#dchips button').forEach(function(c){c.classList.toggle('on',c===b)});document.querySelectorAll('#mem [data-dept]').forEach(function(e){e.hidden=!!b.dataset.d&&e.dataset.dept.split(',').indexOf(b.dataset.d)<0})}});
</script>
<%-include('foot')%>
