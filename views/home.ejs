<div class="row"><a class="btn" href="/systems"><%=x('Sistemleri İncele','Explore Systems')%></a><a class="btn o" href="/sponsor#teklif"><%=x('Sponsor Ol · Teklif Al','Sponsor Us · Get a Quote')%></a><a class="btn o" href="/game"><%=x('Pilotaj Simülasyonu','Pilot Simulator')%></a></div></div>
