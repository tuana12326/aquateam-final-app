<%-include('head')%>
<section class="sec"><div class="wrap">
<%const FL={title_tr:'Başlık (TR)',title_en:'Title (EN)',body_tr:'İçerik (TR)',body_en:'Content (EN)',date:'Tarih',caption_tr:'Açıklama (TR)',caption_en:'Caption (EN)',url:'Görsel / video adresi (veya YouTube bağlantısı)',name:'Ad',link:'Web sitesi bağlantısı (https://...)',logo:'Logo adresi',role_tr:'Görev (TR)',role_en:'Role (EN)',dept:'Departman anahtarları (virgülle: kaptan, yazilim, elektronik, mekanik, test, pilot, danisman)',grade:'Bölüm / sınıf',linkedin:'LinkedIn adresi',alumni:'Mezun (Alumni)'};
const cur=(h)=>path==h?'cur':'';%>
<div class="adm"><a class="<%=cur('/admin')%>" href="/admin">Mesajlar</a><%for(const k in S){%><a class="<%=path.startsWith('/admin/'+k)?'cur':''%>" href="/admin/<%=k%>"><%=LBL[k]%></a><%}%><a class="<%=cur('/admin/files')%>" href="/admin/files">Dosyalar</a><form method="post" action="/admin/logout"><button>Çıkış</button></form></div>
<h1 style="font-size:2rem"><%=title%></h1>
<%if(mode=='home'){%><p class="muted">İletişim, sponsorluk teklif talebi ve üye başvuruları buraya kaydedilir ve takım e-postasına gönderilir. “Gönderilemedi” olanlar 10 dakikada bir otomatik yeniden denenir.</p><%if(!msgs.length){%><div class="soon">Henüz mesaj yok.</div><%}%>
<%for(const m of msgs){%><div class="card msg"><div class="hd"><b><%={contact:'İletişim',sponsor:'Sponsorluk teklif talebi',apply:'Üye başvurusu'}[m.kind]||m.kind%></b><span class="muted"><%=m.created.slice(0,16).replace('T',' ')%></span><span class="pill <%=m.status=='sent'?'ok':m.status=='failed'?'err':''%>"><%=m.status=='sent'?'E-posta gönderildi':m.status=='failed'?'Gönderilemedi':'Bekliyor'%></span><%if(m.note&&m.status!='sent'){%><small class="muted"><%=m.note%></small><%}%></div>
<%for(const k in m.d){if(m.d[k]){%><div><b><%=k%>:</b> <span style="white-space:pre-line"><%=m.d[k]%></span></div><%}}%>
<div class="row" style="margin-top:12px"><%if(m.status!='sent'){%><form method="post" action="/admin/messages/<%=m.id%>/retry"><button>Tekrar gönder</button></form><%}%><form method="post" action="/admin/messages/<%=m.id%>/delete" onsubmit="return confirm('Silinsin mi?')"><button>Sil</button></form></div></div><%}%><%}%>
<%if(mode=='files'){%><%if(q.ok){%><p class="note ok">Yüklendi.</p><%}%><form method="post" enctype="multipart/form-data" class="f"><%const N={logo:'Takım logosu (PNG, şeffaf)',sponsor:'Sponsorluk dosyası (PDF)',model:'3D CAD modeli (.glb) — sistem sayfasında otomatik gösterilir',coral:'CORAL Arayüz v2.3 ekran görüntüsü (PNG)',presskit:'Basın kiti (ZIP)'};for(const k in FILES){%><label><%=N[k]%> <%if(has(FILES[k])){%><span class="ok">● yüklü</span><%}%><input type="file" name="<%=k%>"></label><%}%><button type="submit">Yükle</button></form><%}%>
<%if(mode=='list'){%><p><a class="btn" href="/admin/<%=t%>/form">+ Yeni ekle</a></p><div class="tw"><table><%for(const r of rows){%><tr><td><%=r[S[t][0]]%></td><td><%=r[S[t][1]]||''%></td><td><a href="/admin/<%=t%>/form/<%=r.id%>">Düzenle</a></td><td><form method="post" action="/admin/<%=t%>/<%=r.id%>/delete" onsubmit="return confirm('Silinsin mi?')"><button>Sil</button></form></td></tr><%}%></table></div><%if(!rows.length){%><div class="soon">Kayıt yok.</div><%}%><%}%>
<%if(mode=='form'){%><form method="post" action="/admin/<%=t%>/save" enctype="multipart/form-data" class="f"><%if(q.err){%><p class="note err">İlk alan zorunludur.</p><%}%><input type="hidden" name="id" value="<%=row.id||''%>">
<%for(const c of S[t]){%><label><%=FL[c]||c%><%if(c.startsWith('body')){%><textarea name="<%=c%>"><%=row[c]||''%></textarea><%}else if(c=='alumni'){%><input type="checkbox" name="alumni" value="1" <%=row.alumni?'checked':''%> style="width:auto"><%}else{%><input name="<%=c%>" type="<%=c=='date'?'date':'text'%>" value="<%=row[c]||''%>"><%}%></label><%}%>
<%if(t=='gallery'||t=='sponsors'){%><label>Dosya yükle (png, jpg, webp, gif, mp4 — adres alanının yerine geçer)<input type="file" name="file" accept="image/*,video/mp4"></label><%}%><button type="submit">Kaydet</button></form><%}%>
</div></section>
<%-include('foot')%>
