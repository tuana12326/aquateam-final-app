<%-include('head')%>
<div class="ph"><div class="wrap"><p class="eyebrow"><%=x('Medya & Basın','Media & Press')%></p><h1><%=x('Video, galeri ve','Video, gallery &')%> <span class="acc"><%=x('basın kiti','press kit')%></span></h1><p><%=x('Havuz testi videoları, fotoğraf galerisi ve basın/sponsorlar için indirilebilir basın kiti.','Pool-test videos, a photo gallery and a downloadable press kit for press and sponsors.')%></p></div></div>
<section class="sec"><div class="wrap"><div class="sec-h split" style="max-width:none"><div><p class="eyebrow"><%=x('Galeri','Gallery')%></p><div class="rule"></div><h2><%=x('Fotoğraf ve','Photos &')%> <b>video</b></h2></div><a class="btn o" href="<%=SITE.social.YouTube%>" target="_blank" rel="noopener"><%=x('YouTube Kanalımız','Our YouTube Channel')%> →</a></div>
<div class="grid g3"><%for(const i of g){const id=yt(i.url);%><div class="card"><%if(id){%><iframe class="vid" src="https://www.youtube-nocookie.com/embed/<%=id%>" title="<%=f(i,'caption')%>" allowfullscreen loading="lazy"></iframe><%}else if(/\.mp4$/i.test(i.url)){%><video class="vid" controls preload="metadata" src="<%=i.url%>"></video><%}else{%><img class="vid" src="<%=i.url%>" alt="<%=f(i,'caption')%>" loading="lazy"><%}%><p><%=f(i,'caption')%></p></div><%}%></div>
<%if(!g.length){%><div class="soon"><%=x('Galeri yakında güncellenecek.','Gallery coming soon.')%></div><%}%></div></section>
<section class="sec alt"><div class="wrap"><div class="sec-h"><p class="eyebrow"><%=x('Basın Kiti','Press Kit')%></p><div class="rule"></div><h2><%=x('Kurumsal kimlik','Brand')%> <b><%=x('dosyaları','assets')%></b></h2></div>
<div class="grid g2"><div class="card" style="text-align:center;background:var(--bg)"><img src="<%=has('logo.png')?'/uploads/logo.png':'/img/logo.png'%>" alt="AquaTeam logo" style="max-height:200px;width:auto"><p style="margin-top:14px"><%=x('Şeffaf takım logosu (PNG)','Transparent team logo (PNG)')%></p></div>
<div class="card"><h3><%=x('Kurumsal renkler','Brand colors')%></h3><div class="sw"><i style="background:#050505"></i><b>#050505</b> <span class="muted"><%=x('Mat siyah','Matte black')%></span></div><div class="sw"><i style="background:#00a8ff"></i><b class="acc">#00a8ff</b> <span class="muted"><%=x('AquaTeam mavisi','AquaTeam blue')%></span></div>
<h3 style="margin-top:20px"><%=x('Kısa tanıtım metni','Short introduction')%></h3><p><%=x('AquaTeam, Afyon Kocatepe Üniversitesi mühendislik öğrencilerinden oluşan, çift araçlı CORAL ROV mimarisini geliştiren bir su altı robotik takımıdır.','AquaTeam is an underwater robotics team of Afyon Kocatepe University engineering students developing the dual-vehicle CORAL ROV architecture.')%></p>
<p style="margin-top:18px"><a class="btn" href="/download/presskit"><%=x('Basın Kitini İndir (ZIP)','Download Press Kit (ZIP)')%></a></p></div></div></div></section>
<%-include('foot')%>
